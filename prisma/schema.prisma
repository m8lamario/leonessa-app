generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                     String                      @id @default(uuid())
  email                  String                      @unique
  emailVerified          DateTime?
  name                   String?
  surname                String?
  image                  String?
  passwordHash           String?
  bio                    String?
  instagram              String?
  className              String?
  schoolId               String?
  createdAt              DateTime                    @default(now())
  updatedAt              DateTime                    @updatedAt
  deletedAt              DateTime?
  accounts               Account[]
  auditLogs              AuditLog[]                  @relation("AuditActor")
  recordedCheckIns       CheckIn[]                   @relation("CheckInRecorder")
  createdCompetitions    Competition[]               @relation("CompetitionCreator")
  eventAttendances       EventAttendance[]
  authoredNews           NewsArticle[]
  notifications          Notification[]
  notificationDeliveries NotificationDelivery[]
  followedMatches        FollowedMatch[]
  pointTransactions      PointTransaction[]
  pushDevices            PushDevice[]
  sessions               Session[]
  createdShifts          Shift[]                     @relation("ShiftCreator")
  shiftAssignments       ShiftAssignment[]
  teamApplications       TeamApplication[]
  teamMemberships        TeamMember[]
  school                 School?                     @relation(fields: [schoolId], references: [id])
  badges                 UserBadge[]
  lpBalance              UserLPBalance?
  missions               UserMission[]
  assignedRoles          UserRole[]                  @relation("UserRoleAssigner")
  roles                  UserRole[]
  emailVerifications     EmailVerificationDelivery[]
  fantasyTeam            FantasyTeam?
  fantasyAchievements    FantasyAchievement[]
  sandboxAuditLogs       SandboxAuditLog[]
  referralCode           ReferralCode?
  referralsSent          Referral[]                  @relation("ReferralReferrer")
  referralReceived       Referral?                   @relation("ReferralInvitee")
  referralDevices        ReferralDevice[]
  rewardRedemptions      RewardRedemption[]
  economyConfigChanges   EconomyConfigHistory[]      @relation("EconomyConfigModifier")
  matchPredictions       MatchPrediction[]
  follows                UserFollow[]                @relation("UserFollows")
  followers              UserFollow[]                @relation("UserFollowedBy")

  @@index([schoolId])
  @@index([deletedAt])
  @@index([name, surname])
}

model ReferralCode {
  id        String     @id @default(cuid())
  userId    String     @unique
  code      String     @unique
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  referrals Referral[]
}

model Referral {
  id                 String               @id @default(cuid())
  referralCodeId     String
  referrerId         String
  referredUserId     String               @unique
  status             ReferralStatus       @default(PENDING)
  blockReason        ReferralBlockReason?
  referrerDeviceHash String?
  referredDeviceHash String?
  completedAt        DateTime?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  referralCode       ReferralCode         @relation(fields: [referralCodeId], references: [id], onDelete: Restrict)
  referrer           User                 @relation("ReferralReferrer", fields: [referrerId], references: [id], onDelete: Restrict)
  referredUser       User                 @relation("ReferralInvitee", fields: [referredUserId], references: [id], onDelete: Restrict)

  @@unique([referrerId, referredUserId])
  @@index([referrerId, status, createdAt])
  @@index([referralCodeId])
}

model ReferralDevice {
  id          String   @id @default(cuid())
  userId      String
  deviceHash  String
  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, deviceHash])
  @@index([deviceHash])
}

model FantasyTeam {
  id                  String                      @id @default(cuid())
  userId              String                      @unique
  name                String
  budgetLp            Int                         @default(500)
  totalPoints         Int                         @default(0)
  createdAt           DateTime                    @default(now())
  updatedAt           DateTime                    @updatedAt
  user                User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  players             FantasyTeamPlayer[]
  scores              FantasyScore[]
  transfers           FantasyTeamTransfer[]
  substitutions       FantasySubstitution[]
  lineupVacancies     FantasyLineupVacancy[]
  lineupConfirmations FantasyLineupConfirmation[]
}

model FantasyActivity {
  id          String   @id @default(cuid())
  type        String
  title       String
  description String?
  createdAt   DateTime @default(now())

  @@index([createdAt])
}

model SandboxAuditLog {
  id         String   @id @default(cuid())
  adminId    String
  action     String
  entityType String
  entityId   String?
  before     Json?
  after      Json?
  createdAt  DateTime @default(now())
  admin      User     @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([adminId, createdAt])
}

model FantasyAchievement {
  id         String   @id @default(cuid())
  userId     String
  code       String
  unlockedAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, code])
  @@index([userId, unlockedAt])
}

model FantasyMatchday {
  id                  String                      @id @default(cuid())
  round               Int                         @unique
  startedAt           DateTime?
  completedAt         DateTime?
  valueUpdatedAt      DateTime?
  createdAt           DateTime                    @default(now())
  scores              FantasyScore[]
  transfers           FantasyTeamTransfer[]
  lineupConfirmations FantasyLineupConfirmation[]
}

model FantasyTeamTransfer {
  id            String          @id @default(cuid())
  fantasyTeamId String
  matchdayId    String
  freeTransfers Int             @default(0)
  paidTransfers Int             @default(0)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  fantasyTeam   FantasyTeam     @relation(fields: [fantasyTeamId], references: [id], onDelete: Cascade)
  matchday      FantasyMatchday @relation(fields: [matchdayId], references: [id], onDelete: Cascade)

  @@unique([fantasyTeamId, matchdayId])
  @@index([matchdayId])
}

model FantasyPlayerValueHistory {
  id        String     @id @default(cuid())
  playerId  String
  oldValue  Int
  newValue  Int
  reason    String?
  createdAt DateTime   @default(now())
  player    TeamMember @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@index([playerId, createdAt])
}

model FantasyScore {
  id            String          @id @default(cuid())
  fantasyTeamId String
  matchdayId    String
  points        Int
  createdAt     DateTime        @default(now())
  fantasyTeam   FantasyTeam     @relation(fields: [fantasyTeamId], references: [id], onDelete: Cascade)
  matchday      FantasyMatchday @relation(fields: [matchdayId], references: [id], onDelete: Cascade)

  @@unique([fantasyTeamId, matchdayId])
  @@index([matchdayId])
}

model FantasyPlayerStat {
  id          String     @id @default(cuid())
  playerId    String     @unique
  goals       Int        @default(0)
  assists     Int        @default(0)
  yellowCards Int        @default(0)
  redCards    Int        @default(0)
  matches     Int        @default(0)
  totalPoints Int        @default(0)
  updatedAt   DateTime   @updatedAt
  player      TeamMember @relation(fields: [playerId], references: [id], onDelete: Cascade)
}

model FantasyProcessedMatch {
  id       String   @id @default(cuid())
  matchId  String   @unique
  syncedAt DateTime @default(now())
  match    Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
}

model FantasyTeamPlayer {
  id            String              @id @default(cuid())
  fantasyTeamId String
  playerId      String
  role          String
  status        FantasyLineupStatus @default(STARTER)
  benchOrder    Int?
  purchaseCost  Int                 @default(0)
  isCaptain     Boolean             @default(false)
  createdAt     DateTime            @default(now())
  fantasyTeam   FantasyTeam         @relation(fields: [fantasyTeamId], references: [id], onDelete: Cascade)
  player        TeamMember          @relation(fields: [playerId], references: [id], onDelete: Restrict)

  @@unique([fantasyTeamId, playerId])
  @@index([playerId])
  @@index([fantasyTeamId, status])
}

model FantasyLineupVacancy {
  id            String              @id @default(cuid())
  fantasyTeamId String
  role          String
  status        FantasyLineupStatus
  benchOrder    Int?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  fantasyTeam   FantasyTeam         @relation(fields: [fantasyTeamId], references: [id], onDelete: Cascade)

  @@unique([fantasyTeamId, role, status])
  @@index([fantasyTeamId, status])
}

model FantasyLineupConfirmation {
  id            String          @id @default(cuid())
  fantasyTeamId String
  matchdayId    String
  confirmedAt   DateTime        @default(now())
  fantasyTeam   FantasyTeam     @relation(fields: [fantasyTeamId], references: [id], onDelete: Cascade)
  matchday      FantasyMatchday @relation(fields: [matchdayId], references: [id], onDelete: Cascade)

  @@unique([fantasyTeamId, matchdayId])
  @@index([matchdayId])
}

model FantasySubstitution {
  id            String      @id @default(cuid())
  fantasyTeamId String
  matchId       String
  playerOutId   String
  playerInId    String
  reason        String
  sequence      Int
  createdAt     DateTime    @default(now())
  fantasyTeam   FantasyTeam @relation(fields: [fantasyTeamId], references: [id], onDelete: Cascade)
  match         Match       @relation(fields: [matchId], references: [id], onDelete: Cascade)
  playerOut     TeamMember  @relation("FantasySubstitutionOut", fields: [playerOutId], references: [id], onDelete: Restrict)
  playerIn      TeamMember  @relation("FantasySubstitutionIn", fields: [playerInId], references: [id], onDelete: Restrict)

  @@unique([fantasyTeamId, matchId, playerOutId])
  @@index([matchId])
  @@index([fantasyTeamId, matchId])
}

model EmailVerificationDelivery {
  id        String                        @id @default(uuid())
  userId    String
  kind      EmailVerificationDeliveryKind
  createdAt DateTime                      @default(now())
  user      User                          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, kind, createdAt])
}

model SchoolRanking {
  id            String      @id @default(uuid())
  competitionId String
  schoolId      String
  totalPoints   Int         @default(0)
  wins          Int         @default(0)
  draws         Int         @default(0)
  losses        Int         @default(0)
  matchesPlayed Int         @default(0)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  competition   Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  school        School      @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([competitionId, schoolId])
  @@index([competitionId, totalPoints])
  @@index([schoolId])
}

model Account {
  id                String  @id @default(uuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @map("refresh_token")
  access_token      String? @map("access_token")
  expires_at        Int?    @map("expires_at")
  token_type        String? @map("token_type")
  scope             String?
  id_token          String? @map("id_token")
  session_state     String? @map("session_state")
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model UserRole {
  id           String       @id @default(uuid())
  userId       String
  role         UserRoleType
  isPrimary    Boolean      @default(false)
  assignedById String?
  assignedAt   DateTime     @default(now())
  revokedAt    DateTime?
  assignedBy   User?        @relation("UserRoleAssigner", fields: [assignedById], references: [id])
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, role, revokedAt])
  @@index([assignedById])
}

model School {
  id                String                @id @default(uuid())
  name              String                @unique
  shortName         String                @unique
  logoUrl           String?
  primaryColor      String?
  secondaryColor    String?
  description       String?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  deletedAt         DateTime?
  eslId             String?               @unique
  pointTransactions PointTransaction[]
  rankings          SchoolRanking[]
  supportBalance    SchoolSupportBalance?
  teams             Team[]
  users             User[]

  @@index([deletedAt])
}

model Competition {
  id                String             @id @default(uuid())
  name              String
  slug              String             @unique
  season            String
  status            CompetitionStatus  @default(DRAFT)
  startDate         DateTime
  endDate           DateTime
  createdById       String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  deletedAt         DateTime?
  badges            Badge[]
  createdBy         User?              @relation("CompetitionCreator", fields: [createdById], references: [id])
  events            Event[]
  matches           Match[]
  missions          Mission[]
  newsArticles      NewsArticle[]
  pointTransactions PointTransaction[]
  schoolRankings    SchoolRanking[]
  shifts            Shift[]
  teams             Team[]

  @@index([status, startDate])
  @@index([season])
  @@index([createdById])
  @@index([deletedAt])
}

model Team {
  id            String            @id @default(uuid())
  competitionId String
  schoolId      String
  name          String
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  deletedAt     DateTime?
  eslId         String?           @unique
  awayMatches   Match[]           @relation("AwayTeam")
  homeMatches   Match[]           @relation("HomeTeam")
  competition   Competition       @relation(fields: [competitionId], references: [id])
  school        School            @relation(fields: [schoolId], references: [id])
  applications  TeamApplication[]
  members       TeamMember[]

  @@unique([competitionId, name])
  @@index([schoolId])
  @@index([competitionId, deletedAt])
}

model TeamMember {
  id                String                      @id @default(uuid())
  teamId            String
  userId            String
  eslId             String?                     @unique
  role              TeamMemberRole              @default(PLAYER)
  fantasyRole       String                      @default("CENTROCAMPISTA")
  fantasyValue      Int                         @default(25)
  jerseyNumber      Int?
  schoolYear        String?
  avatarUrl         String?
  isVerifiedPlayer  Boolean                     @default(false)
  joinedAt          DateTime                    @default(now())
  leftAt            DateTime?
  playerEvents      MatchEvent[]                @relation("MatchEventTeamMember")
  relatedEvents     MatchEvent[]                @relation("MatchEventRelatedTeamMember")
  fantasySelections FantasyTeamPlayer[]
  fantasyStat       FantasyPlayerStat?
  valueHistory      FantasyPlayerValueHistory[]
  substitutionsOut  FantasySubstitution[]       @relation("FantasySubstitutionOut")
  substitutionsIn   FantasySubstitution[]       @relation("FantasySubstitutionIn")
  team              Team                        @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user              User                        @relation(fields: [userId], references: [id])

  @@unique([teamId, userId])
  @@unique([teamId, jerseyNumber])
  @@index([userId])
  @@index([teamId, leftAt])
}

model TeamApplication {
  id          String                @id @default(uuid())
  teamId      String
  userId      String
  kind        TeamApplicationKind
  status      TeamApplicationStatus @default(PENDING)
  submittedAt DateTime              @default(now())
  reviewedAt  DateTime?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  team        Team                  @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user        User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId, kind])
  @@index([teamId, status, submittedAt])
  @@index([userId, status, submittedAt])
}

model Match {
  id                     String                 @id @default(uuid())
  competitionId          String
  homeTeamId             String
  awayTeamId             String
  venue                  String?
  startAt                DateTime
  status                 MatchStatus            @default(SCHEDULED)
  homeScore              Int                    @default(0)
  awayScore              Int                    @default(0)
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt
  deletedAt              DateTime?
  eslId                  String?                @unique
  rankingProcessed       Boolean                @default(false)
  awayTeam               Team                   @relation("AwayTeam", fields: [awayTeamId], references: [id])
  competition            Competition            @relation(fields: [competitionId], references: [id])
  homeTeam               Team                   @relation("HomeTeam", fields: [homeTeamId], references: [id])
  events                 MatchEvent[]
  fantasyProcessedMatch  FantasyProcessedMatch?
  fantasySubstitutions   FantasySubstitution[]
  followedBy             FollowedMatch[]
  notificationDeliveries NotificationDelivery[]
  predictions            MatchPrediction[]

  @@index([competitionId, startAt])
  @@index([homeTeamId])
  @@index([awayTeamId])
  @@index([status, startAt])
  @@index([deletedAt])
}

model MatchEvent {
  id              String         @id @default(uuid())
  matchId         String
  eslId           String?        @unique
  type            MatchEventType
  minute          Int
  playerId        String?
  relatedPlayerId String?
  createdAt       DateTime       @default(now())
  match           Match          @relation(fields: [matchId], references: [id], onDelete: Cascade)
  player          TeamMember?    @relation("MatchEventTeamMember", fields: [playerId], references: [id])
  relatedPlayer   TeamMember?    @relation("MatchEventRelatedTeamMember", fields: [relatedPlayerId], references: [id])

  @@index([matchId, minute])
  @@index([playerId])
  @@index([relatedPlayerId])
}

model Shift {
  id            String            @id @default(uuid())
  competitionId String
  title         String
  staffRole     StaffRoleType
  startAt       DateTime
  endAt         DateTime
  rewardPoints  Int               @default(0)
  rewardType    PointType         @default(SP)
  createdById   String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  deletedAt     DateTime?
  competition   Competition       @relation(fields: [competitionId], references: [id])
  createdBy     User?             @relation("ShiftCreator", fields: [createdById], references: [id])
  assignments   ShiftAssignment[]

  @@index([competitionId, startAt])
  @@index([staffRole, startAt])
  @@index([createdById])
  @@index([deletedAt])
}

model ShiftAssignment {
  id          String      @id @default(uuid())
  shiftId     String
  userId      String
  status      ShiftStatus @default(ASSIGNED)
  confirmedAt DateTime?
  completedAt DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  checkIn     CheckIn?
  shift       Shift       @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id])

  @@unique([shiftId, userId])
  @@index([userId, status])
  @@index([shiftId, status])
}

model CheckIn {
  id           String          @id @default(uuid())
  assignmentId String          @unique
  method       CheckInMethod
  checkedInAt  DateTime        @default(now())
  checkedOutAt DateTime?
  recordedById String?
  assignment   ShiftAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  recordedBy   User?           @relation("CheckInRecorder", fields: [recordedById], references: [id])

  @@index([checkedInAt])
  @@index([recordedById])
}

model Mission {
  id            String        @id @default(uuid())
  slug          String?       @unique
  competitionId String?
  title         String
  description   String
  rewardPoints  Int
  rewardType    PointType     @default(LP)
  active        Boolean       @default(true)
  startsAt      DateTime?
  endsAt        DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  deletedAt     DateTime?
  competition   Competition?  @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  users         UserMission[]

  @@index([competitionId, active])
  @@index([active, startsAt, endsAt])
  @@index([deletedAt])
}

model UserMission {
  id          String        @id @default(uuid())
  userId      String
  missionId   String
  status      MissionStatus @default(AVAILABLE)
  progress    Int           @default(0)
  completedAt DateTime?
  claimedAt   DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  mission     Mission       @relation(fields: [missionId], references: [id], onDelete: Cascade)
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, missionId])
  @@index([userId, status])
  @@index([missionId, status])
}

model Badge {
  id            String       @id @default(uuid())
  competitionId String?
  name          String
  slug          String       @unique
  description   String
  iconUrl       String?
  active        Boolean      @default(true)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  deletedAt     DateTime?
  competition   Competition? @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  users         UserBadge[]

  @@index([competitionId, active])
  @@index([deletedAt])
}

model UserBadge {
  id       String   @id @default(uuid())
  userId   String
  badgeId  String
  earnedAt DateTime @default(now())
  badge    Badge    @relation(fields: [badgeId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, badgeId])
  @@index([badgeId])
  @@index([userId, earnedAt])
}

model PointTransaction {
  id             String          @id @default(uuid())
  userId         String
  competitionId  String?
  amount         Int
  type           PointType
  sourceType     PointSourceType
  sourceId       String?
  reason         String
  idempotencyKey String?         @unique
  createdAt      DateTime        @default(now())
  schoolId       String?
  competition    Competition?    @relation(fields: [competitionId], references: [id])
  school         School?         @relation(fields: [schoolId], references: [id])
  user           User            @relation(fields: [userId], references: [id])

  @@index([userId, type, createdAt])
  @@index([schoolId, type, createdAt])
  @@index([competitionId, type, createdAt])
  @@index([sourceType, sourceId])
}

model UserLPBalance {
  id             String   @id @default(uuid())
  userId         String   @unique
  balance        Int      @default(0)
  lifetimeEarned Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([balance])
}

model SchoolSupportBalance {
  id             String   @id @default(uuid())
  schoolId       String   @unique
  points         Int      @default(0)
  lifetimeEarned Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  school         School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([points])
}

model Event {
  id            String            @id @default(uuid())
  competitionId String
  title         String
  description   String?
  startAt       DateTime
  endAt         DateTime?
  location      String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  deletedAt     DateTime?
  competition   Competition       @relation(fields: [competitionId], references: [id])
  attendance    EventAttendance[]

  @@index([competitionId, startAt])
  @@index([deletedAt])
}

model EventAttendance {
  id        String   @id @default(uuid())
  userId    String
  eventId   String
  checkedAt DateTime @default(now())
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, eventId])
  @@index([eventId, checkedAt])
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  type      NotificationType
  title     String
  body      String
  linkUrl   String?
  readAt    DateTime?
  sentAt    DateTime?
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
  @@index([type, createdAt])
}

model PushDevice {
  id                     String                 @id @default(uuid())
  userId                 String
  token                  String                 @unique
  platform               String
  enabled                Boolean                @default(true)
  lastSeenAt             DateTime               @default(now())
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt
  revokedAt              DateTime?
  user                   User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  notificationDeliveries NotificationDelivery[]

  @@index([userId, enabled])
  @@index([userId, revokedAt])
}

model FollowedMatch {
  id        String   @id @default(uuid())
  userId    String
  matchId   String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  match     Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@unique([userId, matchId])
  @@index([matchId])
  @@index([userId, createdAt])
}

model UserFollow {
  id             String    @id @default(cuid())
  followerId     String
  followingId    String
  isAhead        Boolean   @default(false)
  overtakeCount  Int       @default(0)
  lastOvertakeAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  follower       User      @relation("UserFollows", fields: [followerId], references: [id], onDelete: Cascade)
  following      User      @relation("UserFollowedBy", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followingId, createdAt])
  @@index([followerId, createdAt])
  @@index([followerId, lastOvertakeAt])
}

model MatchPrediction {
  id                 String                 @id @default(cuid())
  userId             String
  matchId            String
  choice             MatchPredictionChoice
  status             MatchPredictionStatus  @default(OPEN)
  chosenAt           DateTime               @default(now())
  lockedAt           DateTime?
  settledAt          DateTime?
  resultChoice       MatchPredictionChoice?
  rewardAmount       Int?
  pointTransactionId String?                @unique
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  user               User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  match              Match                  @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@unique([userId, matchId])
  @@index([matchId, status])
  @@index([userId, status])
  @@index([status, settledAt])
}

model NotificationDelivery {
  id               String      @id @default(uuid())
  idempotencyKey   String      @unique
  userId           String
  deviceId         String?
  matchId          String?
  notificationType String
  status           String
  title            String?
  body             String?
  linkUrl          String?
  error            String?
  createdAt        DateTime    @default(now())
  sentAt           DateTime?
  user             User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  device           PushDevice? @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  match            Match?      @relation(fields: [matchId], references: [id], onDelete: SetNull)

  @@index([matchId, notificationType])
  @@index([userId, createdAt])
  @@index([status, createdAt])
}

model NewsArticle {
  id            String       @id @default(uuid())
  competitionId String?
  authorId      String?
  title         String
  slug          String       @unique
  excerpt       String?
  content       String
  type          NewsType     @default(ARTICLE)
  status        NewsStatus   @default(DRAFT)
  publishedAt   DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  deletedAt     DateTime?
  author        User?        @relation(fields: [authorId], references: [id])
  competition   Competition? @relation(fields: [competitionId], references: [id])

  @@index([competitionId, status, publishedAt])
  @@index([authorId])
  @@index([deletedAt])
}

model AuditLog {
  id         String      @id @default(uuid())
  actorId    String?
  action     AuditAction
  entityType String
  entityId   String
  metadata   Json?
  createdAt  DateTime    @default(now())
  actor      User?       @relation("AuditActor", fields: [actorId], references: [id])

  @@index([entityType, entityId, createdAt])
  @@index([actorId, createdAt])
}

model Reward {
  id              String             @id @default(uuid())
  name            String
  description     String
  category        String             @default("merchandise")
  costLp          Int
  imageUrl        String?
  stock           Int?
  active          Boolean            @default(true)
  conditions      String?
  maxPerUser      Int?
  displayOrder    Int                @default(0)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  deletedAt       DateTime?
  redemptions     RewardRedemption[]

  @@index([active, displayOrder])
  @@index([category, active])
  @@index([deletedAt])
}

model RewardRedemption {
  id             String                 @id @default(uuid())
  userId         String
  rewardId       String
  costLp         Int
  status         RewardRedemptionStatus @default(COMPLETED)
  code           String?                @unique
  idempotencyKey String?                @unique
  metadata       Json?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  user           User                   @relation(fields: [userId], references: [id], onDelete: Restrict)
  reward         Reward                 @relation(fields: [rewardId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt])
  @@index([rewardId, status])
  @@index([status, createdAt])
}

model EconomyRewardConfig {
  id              String                 @id @default(uuid())
  key             String                 @unique
  title           String
  description     String?
  category        String                 @default("general")
  rewardLp        Int
  enabled         Boolean                @default(true)
  conditions      Json?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  history         EconomyConfigHistory[]

  @@index([enabled])
}

model EconomyConfigHistory {
  id         String               @id @default(uuid())
  configId   String
  actorId    String?
  oldValue   Int
  newValue   Int
  oldEnabled Boolean
  newEnabled Boolean
  reason     String?
  createdAt  DateTime             @default(now())
  config     EconomyRewardConfig  @relation(fields: [configId], references: [id], onDelete: Cascade)
  actor      User?                @relation("EconomyConfigModifier", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([configId, createdAt])
  @@index([actorId, createdAt])
}

