{
    "version": "0.2.0",
    "configurations": [
      {
        "type": "node",
        "request": "launch",
        "name": "Build & Launch Program",
        "preLaunchTask": "npm run build",
        "skipFiles": [
          "<node_internals>/**"
        ],
        "program": "${workspaceFolder}/src/features/fanta/server/control-center-service.ts",
        "outFiles": [
          "${workspaceFolder}/**/*.js"
        ]
      },
      {
        "type": "node-terminal",
        "request": "launch",
        "name": "Run npm start",
        "command": "npm run start"
      }
    ]
  }